{
  "info": {
    "name": "EduTrack API - Tasks 9 and 10",
    "description": "Registration, login, JWT-protected course writes.\n\nStart the backend (npm run dev in the backend folder) and run the folders in order: 1, 2, 3, 4. Login saves the token into the collection variable {{token}} automatically. Each run registers a fresh email, so the collection can be re-run any number of times.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "LearnSecure123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "existingCourseId",
      "value": "ai-1"
    }
  ],
  "item": [
    {
      "name": "1. Registration and Login (Task 9)",
      "item": [
        {
          "name": "A. Register a student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", \"student\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Message says registered\", function () { pm.expect(json.message).to.eql(\"Student registered successfully\"); });",
                  "pm.test(\"Student details are returned\", function () {",
                  "    pm.expect(json.student).to.have.all.keys(\"id\", \"name\", \"email\", \"department\", \"createdAt\");",
                  "    pm.expect(json.student.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "});",
                  "pm.test(\"Password is never returned\", function () {",
                  "    pm.expect(JSON.stringify(json)).to.not.include(\"passwordHash\");",
                  "    pm.expect(JSON.stringify(json)).to.not.include(pm.collectionVariables.get(\"password\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arun Kumar\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"department\": \"Computer Science\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "B. Register the same email again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Message says email is already registered\", function () {",
                  "    pm.expect(pm.response.json().message).to.eql(\"Email is already registered\");",
