        {
          "name": "C. Log in successfully",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Message says login successful\", function () { pm.expect(json.message).to.eql(\"Login successful\"); });",
                  "pm.test(\"Token, tokenType and expiresIn are returned\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(json.expiresIn).to.eql(\"1h\");",
                  "});",
                  "pm.test(\"Student details are returned without a password\", function () {",
                  "    pm.expect(json.student.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "    pm.expect(JSON.stringify(json.student)).to.not.include(\"passwordHash\");",
                  "});",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
